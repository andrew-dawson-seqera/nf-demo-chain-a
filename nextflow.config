/*
 * nf-demo-chain-a — Data Producer
 */

manifest {
    name            = 'andrew-dawson-seqera/nf-demo-chain-a'
    description     = 'Generates a synthetic sample sheet and drops a marker file for downstream Actions'
    author          = 'Andrew Dawson'
    version         = '1.0.0'
    nextflowVersion = '!>=24.04.0'
    defaultBranch   = 'main'
}

params {
    outdir      = 's3://edu-test-bucket-pipelines/demo-chain'
    num_samples = 5
}

process {
    executor = 'local'
}
